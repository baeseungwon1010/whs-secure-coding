SECRET_KEY=change-me-to-a-long-random-string
DATABASE=instance/market.db

# SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Upload limits
MAX_UPLOAD_MB=5

# Kakao Maps JavaScript API key (https://developers.kakao.com)
KAKAO_MAP_KEY=YOUR_KAKAO_MAP_JS_KEY

# Toss Payments (https://developers.tosspayments.com)
# 테스트 키는 developers.tosspayments.com 가입 후 무료 발급
TOSS_CLIENT_KEY=test_ck_YOUR_CLIENT_KEY
TOSS_SECRET_KEY=test_sk_YOUR_SECRET_KEY

# Initial admin seed
# ADMIN_PASSWORD is applied every startup — changing it here resets the password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Market1
